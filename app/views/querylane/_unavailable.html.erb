<%# locals: (result:, id:) -%>
<%# The backend did not answer: nothing was searched. Hosts override this
    partial to add their own way round (e.g. a roster page). %>
<div class="ql-state ql-state-unavailable" role="status">
  <h2><%= t("querylane.states.unavailable_title") %></h2>
  <p><%= t("querylane.states.unavailable") %></p>
  <button type="submit" form="<%= id %>-form" class="ql-link"><%= t("querylane.states.try_again") %></button>
</div>
