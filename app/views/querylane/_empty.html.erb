<%# locals: (result:, id:) -%>
<%# No hits: say what found nothing and offer one-click ways to widen. Each
    way only rewrites the query, so it is a quiet link, never a button. %>
<div class="ql-empty">
  <h2><%= t("querylane.states.empty_title", searched: result.chips.map(&:label).join(" · ")) %></h2>
  <div class="ql-empty-actions">
    <% result.widenable_facets.each do |facet| %>
      <button type="submit" form="<%= id %>-form" name="widen" value="<%= facet.key %>" class="ql-link"><%= t("querylane.states.widen_#{facet.key}", default: t("querylane.states.widen", facet: facet.label.downcase)) %></button>
    <% end %>
    <%# Every filter can be dropped; the words are the search itself. %>
    <% result.chips.reject(&:words).each do |chip| %>
      <button type="submit" form="<%= id %>-form" name="remove" value="<%= chip.index %>" class="ql-link"><%= t("querylane.states.drop", label: chip.label) %></button>
    <% end %>
    <%# An exact filter that opts in (as_words) can search its typed value as plain words. %>
    <% result.chips.select(&:as_words).each do |chip| %>
      <button type="submit" form="<%= id %>-form" name="as_words" value="<%= chip.index %>" class="ql-link"><%= t("querylane.states.as_words", value: chip.as_words) %></button>
    <% end %>
    <% unless result.relaxed %>
      <button type="submit" form="<%= id %>-form" name="relax" value="1" class="ql-link"><%= t("querylane.states.relax") %></button>
    <% end %>
  </div>
  <p class="ql-facet-note"><%= t("querylane.states.empty_note") %></p>
</div>
